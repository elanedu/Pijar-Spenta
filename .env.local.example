# ==============================================================================
# PIJAR SPENTA - Konfigurasi Environment (.env.local)
# Platform Manajemen Pembelajaran Terpadu Sekolah
# ==============================================================================
# Salin file ini menjadi .env.local:
# cp .env.local.example .env.local
# Kemudian isi dengan kredensial Google Service Account & Sheet ID Anda.

# ------------------------------------------------------------------------------
# 1. Kredensial Google Service Account
# ------------------------------------------------------------------------------
# Didapat dari Google Cloud Console:
# 1) Buka https://console.cloud.google.com/
# 2) Buat Project baru atau pilih project yang sudah ada
# 3) Aktifkan Google Sheets API dan Google Drive API di Library
# 4) Buka IAM & Admin -> Service Accounts -> Create Service Account
# 5) Beri role 'Editor' pada service account tersebut
# 6) Buka tab 'Keys' -> Add Key -> Create new key (pilih tipe JSON)
# 7) Buka file JSON yang terunduh, salin client_email dan private_key ke bawah ini:

GOOGLE_SERVICE_ACCOUNT_EMAIL=pijar-spenta-service-account@nama-project-anda.iam.gserviceaccount.com

# PENTING untuk GOOGLE_PRIVATE_KEY:
# - Simpan persis dengan tanda kutip ganda dua ("...")
# - Pertahankan karakter \n (escaped newline) seperti di file JSON yang didownload
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 2. Google Spreadsheet ID
# ------------------------------------------------------------------------------
# 1) Buat Google Sheet kosong di Google Drive dengan nama "EDULOG_DATABASE"
# 2) Bagikan (Share) sheet tersebut ke GOOGLE_SERVICE_ACCOUNT_EMAIL di atas dengan hak akses 'Editor'
# 3) Ambil ID sheet dari URL di browser:
#    https://docs.google.com/spreadsheets/d/{GOOGLE_SHEET_ID}/edit
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz1234567890abcdef

# ------------------------------------------------------------------------------
# 3. Kunci Rahasia JWT (JSON Web Token)
# ------------------------------------------------------------------------------
# String acak yang digunakan untuk menandatangani token sesi login (Admin, Guru, Siswa).
# Gunakan minimal 32 karakter acak yang aman.
JWT_SECRET=pijar_spenta_super_secret_jwt_key_2024_akademik_sekolah_aman_dan_terpercaya

# ------------------------------------------------------------------------------
# 4. URL Aplikasi
# ------------------------------------------------------------------------------
# Di local: http://localhost:3000
# Di Vercel production: https://pijar-spenta.vercel.app
APP_URL=http://localhost:3000
